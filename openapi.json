{
  "openapi": "3.0.3",
  "info": {
    "title": "Spark Service API",
    "version": "1.0.0",
    "description": "Authentication, user, and project endpoints for the Spark portal."
  },
  "servers": [
    { "url": "/", "description": "Current server" }
  ],
  "tags": [
    { "name": "Authentication" },
    { "name": "Users" },
    { "name": "Projects" },
    { "name": "Applications" },
    { "name": "Service" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Invalid request." }
        }
      },
      "UserRegistration": {
        "type": "object",
        "required": ["email", "displayName", "password", "role"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "alex@example.com" },
          "displayName": { "type": "string", "example": "Alex Smith" },
          "password": { "type": "string", "format": "password", "minLength": 8 },
          "role": { "type": "string", "enum": ["applicant", "manager", "superAdmin"] }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "userId": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "displayName": { "type": "string" },
          "role": { "type": "string", "enum": ["applicant", "manager", "superAdmin"] },
          "status": { "type": "string", "example": "active" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Credentials": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "alex@example.com" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string" }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "tokenType": { "type": "string", "example": "Bearer" },
          "accessToken": { "type": "string" },
          "expiresIn": { "type": "integer", "example": 900 },
          "refreshToken": { "type": "string" }
        }
      },
      "ProjectCreate": {
        "type": "object",
        "required": ["title", "projectName", "duration", "description"],
        "properties": {
          "title": { "type": "string", "example": "Neighborhood Volunteer Program" },
          "projectName": { "type": "string", "example": "Community Garden" },
          "duration": { "type": "string", "example": "8 weeks" },
          "description": { "type": "string", "example": "Build and maintain a neighborhood garden with local volunteers." },
          "status": { "type": "string", "enum": ["open", "closed"], "default": "open" }
        }
      },
      "Project": {
        "type": "object",
        "required": ["id", "projectId", "title", "projectName", "duration", "description", "status", "manager"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "projectId": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "nullable": true },
          "projectName": { "type": "string", "nullable": true },
          "duration": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["open", "closed"] },
          "hasApplied": { "type": "boolean", "description": "Included for applicant responses; true if the authenticated applicant has applied to this project." },
          "manager": {
            "nullable": true,
            "type": "object",
            "properties": {
              "userId": { "type": "string", "format": "uuid" },
              "displayName": { "type": "string" },
              "email": { "type": "string", "format": "email" }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ApplicationCreate": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "maxLength": 2000, "example": "I’m interested in contributing to this project." }
        }
      },
      "ApplicationStatusUpdate": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["selected", "rejected"] }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Same value as userId; unique within the project partition." },
          "projectId": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid" },
          "applicant": {
            "type": "object",
            "properties": {
              "displayName": { "type": "string" },
              "email": { "type": "string", "format": "email" }
            }
          },
          "message": { "type": "string" },
          "status": { "type": "string", "example": "submitted" },
          "appliedAt": { "type": "string", "format": "date-time" },
          "statusUpdatedAt": { "type": "string", "format": "date-time" },
          "statusUpdatedBy": { "type": "string", "format": "uuid" }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": ["Service"],
        "summary": "Check that the service is running",
        "responses": {
          "200": { "description": "Service status text." }
        }
      }
    },
    "/api/users": {
      "post": {
        "tags": ["Users"],
        "summary": "Register a user",
        "description": "Applicant registration is public. Creating a manager or superAdmin requires a superAdmin bearer access token. The password is hashed before storage.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UserRegistration" } }
          }
        },
        "responses": {
          "201": { "description": "User created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } } },
          "400": { "description": "Invalid or missing user fields.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "A privileged role requires a valid access token." },
          "403": { "description": "Only a superAdmin can create privileged users." },
          "409": { "description": "Email already exists." }
        }
      },
      "get": {
        "tags": ["Users"],
        "summary": "Read a user profile by email",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "email" },
            "example": "alex@example.com"
          }
        ],
        "description": "Users can read their own profile. A superAdmin can read any profile.",
        "responses": {
          "200": { "description": "User profile.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } } },
          "401": { "description": "Missing or invalid access token." },
          "403": { "description": "Cannot read another user's profile." },
          "404": { "description": "User not found." }
        }
      }
    },
    "/api/users/all": {
      "get": {
        "tags": ["Users"],
        "summary": "List all users and their roles",
        "description": "SuperAdmin only. Returns public user profile fields and excludes password hashes and authentication data.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "All user profiles.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UserProfile" } } } } },
          "401": { "description": "Missing or invalid access token." },
          "403": { "description": "SuperAdmin role required." },
          "503": { "description": "Cosmos DB is not configured." }
        }
      }
    },
    "/api/user": {
      "get": {
        "tags": ["Users"],
        "summary": "Read the authenticated user's profile",
        "description": "The user identity is taken from the verified bearer access token. No email or user ID is accepted from the request.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Authenticated user's profile.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } } },
          "401": { "description": "Missing or invalid access token." },
          "404": { "description": "User not found." }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Log in and obtain access and refresh tokens",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } } }
        },
        "responses": {
          "200": { "description": "Tokens issued.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } },
          "400": { "description": "Email and password are required." },
          "401": { "description": "Invalid credentials." }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Rotate the refresh token and issue a new access token",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } }
        },
        "responses": {
          "200": { "description": "Rotated tokens.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } },
          "401": { "description": "Refresh token is invalid, expired, revoked, or already used." }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Revoke a refresh token",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } }
        },
        "responses": {
          "204": { "description": "Refresh token revoked or already invalid." }
        }
      }
    },
    "/api/projects": {
      "get": {
        "tags": ["Projects"],
        "summary": "List projects",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Projects returned.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } } } } },
          "401": { "description": "Missing or invalid access token." }
        }
      },
      "post": {
        "tags": ["Projects"],
        "summary": "Create a project",
        "description": "Requires manager or superAdmin role. The manager object is mapped from the authenticated user's Cosmos profile; it cannot be supplied by the caller.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectCreate" } } }
        },
        "responses": {
          "201": { "description": "Project created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } },
          "400": { "description": "Title, projectName, duration, and description are required; status must be open or closed." },
          "401": { "description": "Missing or invalid access token." },
          "403": { "description": "Applicant role cannot create projects." }
        }
      }
    },
    "/api/projects/mine": {
      "get": {
        "tags": ["Projects"],
        "summary": "List projects posted by the authenticated manager",
        "description": "Returns projects whose mapped manager userId matches the authenticated user. SuperAdmins can also see projects they posted.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Projects posted by this user.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } } } } },
          "401": { "description": "Missing or invalid access token." },
          "403": { "description": "Manager or superAdmin role required." }
        }
      }
    },
    "/api/projects/{projectId}/applications": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "post": {
        "tags": ["Applications"],
        "summary": "Apply to a project",
        "description": "Applicant role only. The applicant identity is taken from the verified bearer token. The project must be open. Each user can apply once per project.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplicationCreate" } } }
        },
        "responses": {
          "201": { "description": "Application submitted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Application" } } } },
          "401": { "description": "Missing or invalid access token." },
          "403": { "description": "Only active applicant accounts can apply; managers and superAdmins cannot apply." },
          "404": { "description": "Project not found." },
          "409": { "description": "Project is closed or this user already applied." }
        }
      },
      "get": {
        "tags": ["Applications"],
        "summary": "List applicants for a project",
        "description": "The project's manager can view their own applicants. A superAdmin can view applicants for any project.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Applications for this project.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Application" } } } } },
          "401": { "description": "Missing or invalid access token." },
          "403": { "description": "Not the project's manager or a superAdmin." },
          "404": { "description": "Project not found." }
        }
      }
    },
    "/api/projects/{projectId}/applications/{userId}": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        },
        {
          "name": "userId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" },
          "description": "ID of the applicant who applied to this project."
        }
      ],
      "patch": {
        "tags": ["Applications"],
        "summary": "Select or reject an applicant",
        "description": "Manager role only. The authenticated manager must own the project. Application status can be set to selected or rejected.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplicationStatusUpdate" } } }
        },
        "responses": {
          "200": { "description": "Application status updated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Application" } } } },
          "400": { "description": "Status must be selected or rejected." },
          "401": { "description": "Missing or invalid access token." },
          "403": { "description": "Manager does not own the project." },
          "404": { "description": "Project or application not found." }
        }
      }
    },
    "/api/applications/me": {
      "get": {
        "tags": ["Applications"],
        "summary": "List the authenticated applicant's applications",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Applications submitted by this user.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Application" } } } } },
          "401": { "description": "Missing or invalid access token." },
          "403": { "description": "Applicant role required." }
        }
      }
    }
  }
}
